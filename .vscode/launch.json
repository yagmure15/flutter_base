    "version": "0.2.0",
    "configurations": [
        {
            "name": "client (dev)",
            "cwd": "apps/client",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_dev.dart",
            "args": ["--flavor", "dev"]
        },
        {
            "name": "client (staging)",
            "cwd": "apps/client",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_staging.dart",
            "args": ["--flavor", "staging"]
        },
        {
            "name": "client (prod)",
            "cwd": "apps/client",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_prod.dart",
            "args": ["--flavor", "prod"]
        },
        {
            "name": "client (prod, release mode)",
            "cwd": "apps/client",
            "request": "launch",
            "type": "dart",
            "program": "lib/main_prod.dart",
            "args": ["--flavor", "prod"],
            "flutterMode": "release"
        },
        {
            "name": "widgetbook",
            "cwd": "apps/widgetbook",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "widgetbook (profile mode)",
            "cwd": "apps/widgetbook",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "widgetbook (release mode)",
            "cwd": "apps/widgetbook",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}
